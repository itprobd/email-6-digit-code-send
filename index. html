<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Send Verification Code</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box;}
        body{font-family:system-ui;background:#1a1a2e;max-width:500px;margin:0 auto;padding:20px;min-height:100vh;display:flex;flex-direction:column;}
        .card{background:white;border-radius:16px;padding:30px;box-shadow:0 10px 30px rgba(0,0,0,0.2);}
        h1{text-align:center;color:#333;margin-bottom:30px;font-size:24px;}
        input{width:100%;padding:15px;border:2px solid #e0e6ed;border-radius:12px;font-size:16px;margin-bottom:15px;transition:all 0.3s;}
        input:focus{outline:none;border-color:#007bff;box-shadow:0 0 0 3px rgba(0,123,255,0.1);}
        button{width:100%;padding:15px;background:#007bff;color:white;border:none;border-radius:12px;font-size:16px;font-weight:600;cursor:pointer;transition:background 0.3s;}
        button:hover{background:#0056b3;}
        button:disabled{background:#ccc;cursor:not-allowed;}
        .result{margin:15px 0;padding:15px;border-radius:12px;font-family:monospace;font-size:14px;word-break:break-all;}
        .success{background:#d4edda;color:#155724;border:1px solid #c3e6cb;}
        .error{background:#f8d7da;color:#721c24;border:1px solid #f5c6cb;}
        .bulk{background:#28a745;color:white;padding:10px;border-radius:8px;margin:10px 0;cursor:pointer;text-align:center;}
        .bulk:hover{background:#218838;}
    </style>
</head>
<body>
    <div class="card">
        <h1>📧 Send Verification Code</h1>
        
        <input id="email" type="email" placeholder="admin@target.com" />
        <input id="customCode" type="number" min="100000" max="999999" placeholder="Optional: 123456" />
        
        <button onclick="sendCode()">🔥 SEND LIVE CODE</button>
        
        <div id="result" class="result" style="display:none;"></div>
        
        <div class="bulk" onclick="bulkTest()">⚡ Test 10 Random Emails</div>
    </div>

    <script>
        const API_URL = 'http://localhost:3000/send-code';
        
        async function sendCode() {
            const email = document.getElementById('email').value;
            const customCode = document.getElementById('customCode').value;
            
            if (!email) return showResult('Enter email first', 'error');
            
            const btn = event.target;
            btn.disabled = true;
            btn.textContent = 'Sending...';
            
            try {
                const res = await fetch(API_URL, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({email, customCode})
                });
                
                const data = await res.json();
                
                if (data.success) {
                    showResult(`✅ ${data.message}\n💰 Code: ${data.code}`, 'success');
                    navigator.clipboard.writeText(`${email}:${data.code}`);
                } else {
                    showResult(`❌ ${data.error}`, 'error');
                }
            } catch(e) {
                showResult(`❌ Network error: ${e.message}\nCheck API running on port 3000`, 'error');
            }
            
            btn.disabled = false;
            btn.textContent = '🔥 SEND LIVE CODE';
        }
        
        function showResult(msg, type) {
            const el = document.getElementById('result');
            el.textContent = msg;
            el.className = `result ${type}`;
            el.style.display = 'block';
            el.scrollIntoView({behavior: 'smooth'});
        }
        
        async function bulkTest() {
            const testEmails = [
                `user${Math.random().toString(36).slice(2,8)}@gmail.com`,
                `test${Date.now()}@outlook.com`,
                // Add your targets here
            ];
            
            for (let email of testEmails) {
                document.getElementById('email').value = email;
                await sendCode();
                await new Promise(r=>setTimeout(r,2000));
            }
        }
        
        // ENTER to send
        document.addEventListener('keypress', e => {
            if (e.key === 'Enter' && e.target.tagName !== 'INPUT') {
                sendCode();
            }
        });
    </script>
</body>
</html>